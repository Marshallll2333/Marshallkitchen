.section-title {
  font-weight: 700;
  margin-bottom: 16rpx;
}

.top {
  margin-top: 24rpx;
}

.dish-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1e5d5;
}

.dish-row:last-child {
  border-bottom: 0;
}

.name {
  font-weight: 700;
}

.actions {
  display: grid;
  gap: 16rpx;
}

