<view class="page">
  <view class="page-title">配方设置</view>
  <view class="page-subtitle">{{dish.name || '菜品'}} 的食材、调味料、工具和步骤。</view>

  <view class="section panel">
    <view class="label">原材料，每行：名称 数量 单位</view>
    <textarea class="textarea" value="{{materialsRaw}}" bindinput="onMaterialsInput"></textarea>

    <view class="label space">调味料，每行：名称 数量 单位</view>
    <textarea class="textarea" value="{{seasoningsRaw}}" bindinput="onSeasoningsInput"></textarea>

    <view class="label space">工具，每行一个名称</view>
    <textarea class="textarea" value="{{toolsRaw}}" bindinput="onToolsInput"></textarea>

    <view class="label space">步骤，每行一步</view>
    <textarea class="textarea steps" value="{{stepsRaw}}" bindinput="onStepsInput"></textarea>

    <button class="btn section" bindtap="saveRecipe">保存配方</button>
  </view>
</view>

