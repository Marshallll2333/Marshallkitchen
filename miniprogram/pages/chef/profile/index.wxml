<view class="page">
  <view class="panel">
    <view class="page-title">你的厨师端</view>
    <view class="page-subtitle">首版重点是接单、看配方、扣库存和记录历史。</view>
  </view>

  <view class="section panel">
    <view class="label">当前身份</view>
    <view>{{user.nickname || '厨师'}} · {{user.openid || ''}}</view>
  </view>

  <view class="section actions">
    <button class="btn" bindtap="goDashboard">回工作台</button>
    <button class="btn ghost" bindtap="goInventory">库存管理</button>
    <button class="btn ghost" bindtap="goDishes">菜品管理</button>
  </view>
</view>

