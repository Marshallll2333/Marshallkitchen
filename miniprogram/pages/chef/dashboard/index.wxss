.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat {
  background: #ffffff;
  border: 1rpx solid #eadfce;
  border-radius: 16rpx;
  padding: 22rpx 12rpx;
  text-align: center;
  color: #826959;
  font-size: 24rpx;
}

.stat text {
  display: block;
  color: #2f7d32;
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.actions {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

