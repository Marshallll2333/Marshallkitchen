<view class="page">
  <view class="page-title">做菜详情</view>
  <view class="page-subtitle">配方已按她的口味备注做了首版调整。</view>

  <view wx:for="{{cookItems}}" wx:key="cartKey" class="section panel">
    <view class="between">
      <view class="dish-title">{{item.name}} × {{item.quantity}}</view>
      <text class="price">约 {{item.cookTime}} 分钟</text>
    </view>
    <view wx:if="{{item.remark || item.tasteOptionsText}}" class="notice">备注：{{item.remark || ''}} {{item.tasteOptionsText}}</view>

    <view class="block-title">原材料</view>
    <view wx:for="{{item.recipe.materials}}" wx:key="name" class="line">{{item.name}} {{item.amount}}{{item.unit}}</view>

    <view class="block-title">调味料</view>
    <view wx:for="{{item.recipe.seasonings}}" wx:key="name" class="line">{{item.name}} {{item.amount}}{{item.unit}}</view>

    <view class="block-title">工具</view>
    <text wx:for="{{item.recipe.tools}}" wx:key="name" class="tag">{{item.name}}</text>

    <view class="block-title">步骤</view>
    <view wx:for="{{item.recipe.steps}}" wx:key="*this" class="step">{{index + 1}}. {{item}}</view>
  </view>

  <view class="bottom-bar">
    <view>做好后会扣减库存</view>
    <button class="btn small" bindtap="finishOrder">完成出餐</button>
  </view>
</view>

