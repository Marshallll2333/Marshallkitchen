<view class="page">
  <view class="between">
    <view>
      <view class="page-title">菜品管理</view>
      <view class="page-subtitle">维护今天能给她做什么。</view>
    </view>
    <button class="btn small" bindtap="newDish">新增</button>
  </view>

  <view wx:if="{{editing}}" class="section panel">
    <input class="input" placeholder="菜名" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
    <input class="input space" placeholder="分类" value="{{form.category}}" data-field="category" bindinput="onFormInput" />
    <input class="input space" type="number" placeholder="价格" value="{{form.price}}" data-field="price" bindinput="onFormInput" />
    <input class="input space" type="number" placeholder="制作分钟" value="{{form.cookTime}}" data-field="cookTime" bindinput="onFormInput" />
    <input class="input space" placeholder="展示 emoji，例如 🍅" value="{{form.emoji}}" data-field="emoji" bindinput="onFormInput" />
    <textarea class="textarea space" placeholder="顾客端简介" value="{{form.description}}" data-field="description" bindinput="onFormInput"></textarea>
    <view class="row toggles">
      <label><checkbox checked="{{form.isListed}}" data-field="isListed" bindtap="toggleBool" />上架</label>
      <label><checkbox checked="{{form.isFavorite}}" data-field="isFavorite" bindtap="toggleBool" />她爱吃</label>
    </view>
    <view class="row buttons">
      <button class="btn" bindtap="saveDish">保存菜品</button>
      <button class="btn ghost" bindtap="cancelEdit">取消</button>
    </view>
  </view>

  <view class="section">
    <dish-card wx:for="{{dishes}}" wx:key="_id" dish="{{item}}" show-add="{{false}}" bind:tapdish="editDish"></dish-card>
    <view wx:if="{{!dishes.length}}" class="empty">还没有菜品。</view>
  </view>
</view>

