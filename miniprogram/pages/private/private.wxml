<view class="page">
  <view class="panel hero">
    <view class="lock">🔒</view>
    <view class="page-title">这是私人小厨房</view>
    <view class="page-subtitle">当前微信还没有绑定厨师或顾客身份。把下面的 openid 加到云数据库 `app_config.roles` 后再重新进入。</view>
  </view>

  <view class="section panel">
    <view class="label">当前 openid</view>
    <view class="openid">{{openid || '登录后自动显示'}}</view>
    <button class="btn ghost section" bindtap="copyOpenid">复制 openid</button>
  </view>

  <view class="section panel">
    <view class="label">需要配置的文档</view>
    <view class="page-subtitle">查看 `docs/deploy.md`，把你的 openid 放进 chefOpenids，把她的 openid 放进 customerOpenids。</view>
  </view>
</view>

