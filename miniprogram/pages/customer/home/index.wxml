<view class="page">
  <view class="between">
    <view>
      <view class="page-title">今天想吃什么？</view>
      <view class="page-subtitle">只展示现在库存够、工具也可用的菜。</view>
    </view>
    <button class="btn small ghost" bindtap="goProfile">我的</button>
  </view>

  <view class="section">
    <input class="input" placeholder="搜索菜名、分类或标签" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="loadDishes" />
  </view>

  <scroll-view class="categories" scroll-x>
    <text wx:for="{{categories}}" wx:key="*this" class="tag {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory">{{item}}</text>
  </scroll-view>

  <view class="section">
    <dish-card wx:for="{{dishes}}" wx:key="_id" dish="{{item}}" bind:tapdish="openDish" bind:adddish="quickAdd"></dish-card>
    <view wx:if="{{!loading && !dishes.length}}" class="empty">今天还没有可点的菜，等厨师补库存或上架菜品。</view>
  </view>

  <view class="bottom-bar" bindtap="goCart">
    <view>已选 {{cartCount}} 份</view>
    <view class="btn small">去点菜单</view>
  </view>
</view>

