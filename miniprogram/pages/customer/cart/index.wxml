<view class="page">
  <view class="page-title">我的点菜单</view>
  <view class="page-subtitle">想吃什么都放这里，提交后厨师就会看到。</view>

  <view class="section">
    <view wx:for="{{items}}" wx:key="cartKey" class="panel cart-item">
      <view class="between">
        <view>
          <view class="name">{{item.name}}</view>
          <view class="muted">￥{{item.price}} · {{item.tasteOptionsText || '正常口味'}}</view>
          <view wx:if="{{item.remark}}" class="muted">备注：{{item.remark}}</view>
        </view>
        <view class="qty">
          <button class="btn small ghost" data-key="{{item.cartKey}}" data-delta="-1" bindtap="adjustItem">-</button>
          <text>{{item.quantity}}</text>
          <button class="btn small" data-key="{{item.cartKey}}" data-delta="1" bindtap="adjustItem">+</button>
        </view>
      </view>
    </view>
    <view wx:if="{{!items.length}}" class="empty">点菜单还是空的。</view>
  </view>

  <view class="section panel">
    <view class="label">整单备注</view>
    <textarea class="textarea" placeholder="例如：少盐，不放葱，想早点吃" value="{{remark}}" bindinput="onRemarkInput"></textarea>
    <view class="label space">今天想什么时候吃</view>
    <view>
      <text wx:for="{{timeOptions}}" wx:key="*this" class="tag {{expectedTime === item ? 'active' : ''}}" data-time="{{item}}" bindtap="selectTime">{{item}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view>
      <view>合计 ￥{{totalPrice}}</view>
      <view class="small-text">预计 {{estimateTime}}</view>
    </view>
    <button class="btn small" bindtap="submitOrder">提交给他做</button>
  </view>
</view>

