<view class="page">
  <view class="page-title">订单进度</view>
  <view class="page-subtitle">这里会显示已下单、制作中和可以吃啦。</view>

  <view wx:if="{{currentOrder}}" class="section panel current">
    <view class="between">
      <text class="status">{{currentOrder.statusText}}</text>
      <text>#{{currentOrder.orderNo}}</text>
    </view>
    <view class="items">
      <view wx:for="{{currentOrder.items}}" wx:key="dishId">{{item.name}} × {{item.quantity}}</view>
    </view>
    <view wx:if="{{currentOrder.remark}}" class="muted">备注：{{currentOrder.remark}}</view>
  </view>

  <view class="section">
    <order-card wx:for="{{orders}}" wx:key="_id" order="{{item}}" role="customer" bind:taporder="openOrder"></order-card>
    <view wx:if="{{!orders.length}}" class="empty">还没有历史订单。</view>
  </view>
</view>

