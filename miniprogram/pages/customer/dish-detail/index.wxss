.dish-hero {
  padding: 36rpx 24rpx;
  text-align: center;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff, #fff1df);
  border: 1rpx solid #eadfce;
}

.dish-emoji {
  font-size: 116rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

.dish-photo {
  width: 100%;
  height: 360rpx;
  border-radius: 18rpx;
  display: block;
  margin-bottom: 24rpx;
}

.meta {
  margin-top: 24rpx;
}

.section-title {
  font-weight: 700;
  margin-bottom: 16rpx;
}

.qty {
  display: flex;
  align-items: center;
  gap: 26rpx;
  font-weight: 700;
}
