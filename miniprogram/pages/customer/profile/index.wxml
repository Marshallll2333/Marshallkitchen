<view class="page">
  <view class="panel">
    <view class="page-title">她的点菜单</view>
    <view class="page-subtitle">这里只保留和点菜有关的轻量信息。</view>
  </view>

  <view class="section panel">
    <view class="label">当前身份</view>
    <view>{{user.nickname || '顾客'}} · {{user.openid || ''}}</view>
  </view>

  <view class="section panel">
    <view class="label">常用口味</view>
    <text wx:for="{{tastePreferences}}" wx:key="*this" class="tag">{{item}}</text>
    <view wx:if="{{!tastePreferences.length}}" class="muted">暂未设置，首版可在下单时选择。</view>
  </view>

  <view class="section">
    <button class="btn" bindtap="goOrders">查看历史订单</button>
  </view>
</view>

