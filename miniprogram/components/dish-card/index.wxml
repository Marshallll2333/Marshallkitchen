<view class="dish-card" bindtap="handleTap">
  <view class="dish-visual">
    <image wx:if="{{dish.imageUrl}}" class="dish-image" src="{{dish.imageUrl}}" mode="aspectFill"></image>
    <text wx:else>{{dish.emoji || '🍳'}}</text>
  </view>
  <view class="dish-info">
    <view class="between">
      <text class="dish-name">{{dish.name}}</text>
      <text class="price">￥{{dish.price}}</text>
    </view>
    <view class="dish-desc">{{dish.description}}</view>
    <view class="dish-meta">
      <text>{{dish.category}}</text>
      <text>约 {{dish.cookTime}} 分钟</text>
      <text wx:if="{{dish.isFavorite}}">她爱吃</text>
    </view>
    <view wx:if="{{dish.missingReasons && dish.missingReasons.length}}" class="missing">
      {{dish.missingReasons[0]}}
    </view>
  </view>
  <button wx:if="{{showAdd}}" class="add-btn" catchtap="handleAdd">+</button>
</view>
