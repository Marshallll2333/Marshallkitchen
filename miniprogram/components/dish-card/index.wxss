.dish-card {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #eadfce;
  box-shadow: 0 8rpx 24rpx rgba(74, 52, 40, 0.05);
}

.dish-visual {
  width: 128rpx;
  height: 128rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #fff1df, #f7d8c9);
  font-size: 58rpx;
  overflow: hidden;
}

.dish-image {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-info {
  min-width: 0;
  flex: 1;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #4a3428;
}

.dish-desc {
  margin-top: 8rpx;
  line-height: 1.45;
  color: #826959;
  font-size: 25rpx;
}

.dish-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
  color: #356b38;
  font-size: 23rpx;
}

.missing {
  margin-top: 10rpx;
  color: #e85d45;
  font-size: 23rpx;
}

.add-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2f7d32;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 56rpx;
}

.add-btn::after {
  border: 0;
}
