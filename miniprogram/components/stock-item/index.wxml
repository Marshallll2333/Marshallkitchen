<view class="stock-item">
  <view>
    <view class="name">{{item.name}}</view>
    <view class="meta">{{item.category || item.status || '库存'}} · 安全线 {{item.safeStock || 0}}{{item.unit || ''}}</view>
  </view>
  <view class="right">
    <text class="{{low ? 'low' : 'count'}}">{{item.stock !== undefined ? item.stock : item.count}}{{item.unit || ''}}</text>
    <button class="btn small ghost" data-delta="-1" bindtap="handleAdjust">-</button>
    <button class="btn small" data-delta="1" bindtap="handleAdjust">+</button>
  </view>
</view>

