<view class="order-card" bindtap="handleTap">
  <view class="between">
    <text class="order-no">#{{order.orderNo}}</text>
    <text class="status">{{statusText}}</text>
  </view>
  <view class="items">
    <text wx:for="{{order.items}}" wx:key="dishId">{{item.name}} × {{item.quantity}}{{index < order.items.length - 1 ? '，' : ''}}</text>
  </view>
  <view wx:if="{{order.remark}}" class="remark">备注：{{order.remark}}</view>
  <view class="between footer">
    <text>{{order.createdAtText}}</text>
    <text class="price">￥{{order.totalPrice}}</text>
  </view>
</view>

