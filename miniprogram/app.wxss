page {
  min-height: 100vh;
  background: #fff8ee;
  color: #4a3428;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 150rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 12rpx;
}

.page-subtitle {
  color: #826959;
  font-size: 26rpx;
  line-height: 1.55;
}

.section {
  margin-top: 28rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #eadfce;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(74, 52, 40, 0.05);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #8d7666;
}

.price {
  color: #e85d45;
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f2f8ee;
  color: #356b38;
  font-size: 24rpx;
  margin: 8rpx 10rpx 0 0;
}

.tag.active {
  background: #2f7d32;
  color: #ffffff;
}

.btn {
  height: 80rpx;
  border-radius: 14rpx;
  background: #2f7d32;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
}

.btn::after {
  border: 0;
}

.btn.secondary {
  background: #fff3e5;
  color: #a0522d;
}

.btn.danger {
  background: #e85d45;
}

.btn.ghost {
  background: #ffffff;
  color: #2f7d32;
  border: 1rpx solid #b7d9b1;
}

.btn.small {
  height: 58rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  padding: 0 18rpx;
}

.input,
.textarea {
  width: 100%;
  border-radius: 14rpx;
  border: 1rpx solid #eadfce;
  background: #fffdf8;
  color: #4a3428;
  padding: 18rpx 20rpx;
}

.textarea {
  min-height: 150rpx;
  line-height: 1.5;
}

.bottom-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #4a3428;
  color: #fff8ee;
  box-shadow: 0 14rpx 38rpx rgba(74, 52, 40, 0.2);
  z-index: 20;
}

.empty {
  padding: 60rpx 24rpx;
  text-align: center;
  color: #8d7666;
}

